<Page x:Class="Biblioteca.WPF.Views.SociosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Socios"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Socios" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Registre, busque y dé de baja socios. La baja es lógica: el socio deja de mostrarse pero no se borra."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="txtBuscar" Grid.Column="0" Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Buscar por nombre o DNI…"
                                    ClearButtonEnabled="True" TextChanged="txtBuscar_TextChanged" />
                        <ui:Button x:Name="btnActualizar" Grid.Column="1" Margin="8,0,0,0" Padding="10"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Actualizar"
                                   Click="btnActualizar_Click" />
                    </Grid>

                    <DataGrid x:Name="dgSocios" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgSocios_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="110"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="panelVacio" Grid.Row="1" Style="{StaticResource EmptyState}">
                        <ui:SymbolIcon Symbol="People24" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="txtVacio" Text="No hay socios." Margin="0,10,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                    </StackPanel>

                    <ui:ProgressRing x:Name="anilloCarga" Grid.Row="1" IsIndeterminate="True"
                                     Width="48" Height="48" Visibility="Collapsed" />
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="txtTituloForm" Text="Nuevo socio" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="txtAyudaForm" Text="Complete los datos y presione Guardar."
                               Style="{StaticResource HintText}" />

                    <TextBlock Text="DNI" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtDni" PlaceholderText="8 dígitos" MaxLength="8" />

                    <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtNombre" PlaceholderText="Ej. María Moya" MaxLength="100" />

                    <TextBlock Text="Email (opcional)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtEmail" PlaceholderText="nombre@correo.com" MaxLength="100"
                                Icon="{ui:SymbolIcon Mail24}" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnNuevo" Grid.Column="0" Content="Nuevo" HorizontalAlignment="Stretch"
                                   Icon="{ui:SymbolIcon Add24}" Click="btnNuevo_Click" />
                        <ui:Button x:Name="btnGuardar" Grid.Column="2" Content="Guardar" HorizontalAlignment="Stretch"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="btnGuardar_Click" />
                    </Grid>

                    <ui:Button x:Name="btnEliminar" Content="Dar de baja" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                               Click="btnEliminar_Click" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
