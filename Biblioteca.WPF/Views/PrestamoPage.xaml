<Page x:Class="Biblioteca.WPF.Views.PrestamoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Préstamo"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Registrar préstamo" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="txtSubtitulo" Style="{StaticResource PageSubtitle}"
                       Text="Seleccione un socio y agregue uno o varios libros." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Selección -->
            <ui:Card Grid.Column="0" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Socio" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="cmbSocio" DisplayMemberPath="Nombre" SelectedValuePath="SocioId"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="Libro" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="cmbLibro" SelectedValuePath="LibroId" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}" />
                                    <TextBlock Style="{StaticResource HintText}">
                                        <Run Text="{Binding AutorNombre, Mode=OneWay}" /> ·
                                        <Run Text="{Binding Ejemplares, Mode=OneWay}" /> disponibles
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ui:Button x:Name="btnAgregar" Content="Agregar libro" Margin="0,16,0,0"
                               HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Add24}" Click="btnAgregar_Click" />

                    <TextBlock Margin="0,20,0,0" Style="{StaticResource HintText}"
                               Text="Reglas: máximo 3 libros pendientes por socio, y solo libros con ejemplares disponibles." />
                </StackPanel>
            </ui:Card>

            <!-- Libros del préstamo -->
            <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Libros del préstamo" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,12" />

                    <DataGrid x:Name="dgCarrito" Grid.Row="1" Style="{StaticResource ModernGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding AutorNombre}" Width="2*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="150"
                                                ElementStyle="{StaticResource TextCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <ui:ProgressRing x:Name="anilloCarga" Grid.Row="1" IsIndeterminate="True"
                                     Width="48" Height="48" Visibility="Collapsed" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button x:Name="btnQuitar" Content="Quitar seleccionado" Margin="0,0,8,0"
                                   Icon="{ui:SymbolIcon Delete24}" Click="btnQuitar_Click" />
                        <ui:Button x:Name="btnRegistrar" Content="Registrar préstamo" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Checkmark24}" Click="btnRegistrar_Click" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
