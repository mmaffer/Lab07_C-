<Page x:Class="Biblioteca.WPF.Views.DevolucionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Devolución"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Registrar devolución" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Seleccione un socio y el libro que devuelve. La multa se calcula con la fecha de hoy."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Socio" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <ComboBox x:Name="cmbSocio" DisplayMemberPath="Nombre" SelectedValuePath="SocioId"
                                  HorizontalAlignment="Stretch" SelectionChanged="cmbSocio_SelectionChanged" />
                    </StackPanel>

                    <DataGrid x:Name="dgPendientes" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgPendientes_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Préstamo" Binding="{Binding PrestamoId}" Width="90"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Libro" Binding="{Binding Titulo}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Fecha préstamo" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}"
                                                Width="130" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}"
                                                Width="120" ElementStyle="{StaticResource TextCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="panelVacio" Grid.Row="1" Style="{StaticResource EmptyState}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="txtVacio" Text="Seleccione un socio." Margin="0,10,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                    </StackPanel>

                    <ui:ProgressRing x:Name="anilloCarga" Grid.Row="1" IsIndeterminate="True"
                                     Width="48" Height="48" Visibility="Collapsed" />
                </Grid>
            </ui:Card>

            <!-- Detalle y multa -->
            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Devolución" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="txtLibro" Text="Seleccione un libro de la lista."
                               Style="{StaticResource HintText}" />

                    <TextBlock Text="Fecha límite" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="txtLimite" Text="–" FontSize="16" />

                    <TextBlock Text="Fecha de devolución (hoy)" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="txtHoy" Text="–" FontSize="16" />

                    <TextBlock Text="Días de retraso" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="txtDias" Text="–" FontSize="16" />

                    <TextBlock Text="Multa" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="txtMulta" Text="–" FontSize="28" FontWeight="SemiBold" />

                    <ui:Button x:Name="btnDevolver" Content="Registrar devolución" Margin="0,24,0,0"
                               HorizontalAlignment="Stretch" Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowImport24}" Click="btnDevolver_Click" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
