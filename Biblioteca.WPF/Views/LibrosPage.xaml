<Page x:Class="Biblioteca.WPF.Views.LibrosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Libros"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Libros" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Registre, busque y dé de baja libros. La baja es lógica: el libro deja de mostrarse pero no se borra."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Lista -->
            <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="txtBuscar" Grid.Column="0" Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Buscar por título o autor…"
                                    ClearButtonEnabled="True" TextChanged="txtBuscar_TextChanged" />
                        <ui:Button x:Name="btnActualizar" Grid.Column="1" Margin="8,0,0,0" Padding="10"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Actualizar"
                                   Click="btnActualizar_Click" />
                    </Grid>

                    <DataGrid x:Name="dgLibros" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgLibros_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding AutorNombre}" Width="2*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="150"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Ejemplares" Binding="{Binding Ejemplares}" Width="90"
                                                ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="panelVacio" Grid.Row="1" Style="{StaticResource EmptyState}">
                        <ui:SymbolIcon Symbol="Book24" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="txtVacio" Text="No hay libros." Margin="0,10,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                    </StackPanel>

                    <ui:ProgressRing x:Name="anilloCarga" Grid.Row="1" IsIndeterminate="True"
                                     Width="48" Height="48" Visibility="Collapsed" />
                </Grid>
            </ui:Card>

            <!-- Formulario -->
            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="txtTituloForm" Text="Nuevo libro" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="txtAyudaForm" Text="Complete los datos y presione Guardar."
                               Style="{StaticResource HintText}" />

                    <TextBlock Text="Título" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtTitulo" PlaceholderText="Ej. Rayuela" MaxLength="150" />

                    <TextBlock Text="ISBN" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtIsbn" PlaceholderText="Ej. 978-0-00-000021" MaxLength="20" />

                    <TextBlock Text="Autor" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="cmbAutor" DisplayMemberPath="Nombre" SelectedValuePath="AutorId"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="Ejemplares" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtEjemplares" PlaceholderText="Ej. 3" MaxLength="4" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnNuevo" Grid.Column="0" Content="Nuevo" HorizontalAlignment="Stretch"
                                   Icon="{ui:SymbolIcon Add24}" Click="btnNuevo_Click" />
                        <ui:Button x:Name="btnGuardar" Grid.Column="2" Content="Guardar" HorizontalAlignment="Stretch"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="btnGuardar_Click" />
                    </Grid>

                    <ui:Button x:Name="btnEliminar" Content="Dar de baja" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                               Click="btnEliminar_Click" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
