<Page x:Class="Biblioteca.WPF.Views.ReportePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Reporte"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reporte de préstamos" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Préstamos registrados dentro de un intervalo de fechas."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ui:Card Grid.Row="1" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Desde" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <DatePicker x:Name="dpDesde" Width="180" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <DatePicker x:Name="dpHasta" Width="180" />
                    </StackPanel>
                    <ui:Button x:Name="btnConsultar" Content="Consultar" Appearance="Primary"
                               VerticalAlignment="Bottom" Icon="{ui:SymbolIcon Search24}" Click="btnConsultar_Click" />
                </StackPanel>

                <DataGrid x:Name="dgReporte" Grid.Row="1" Style="{StaticResource ModernGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding PrestamoId}" Width="60"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="2*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="3*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Préstamo" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}"
                                            Width="100" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}"
                                            Width="110" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Devolución" Binding="{Binding FechaDevolucion, StringFormat=dd/MM/yyyy, TargetNullValue=—}"
                                            Width="100" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"
                                            ElementStyle="{StaticResource TextCell}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="panelVacio" Grid.Row="1" Style="{StaticResource EmptyState}">
                    <ui:SymbolIcon Symbol="DocumentTable24" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="txtVacio" Text="No hay préstamos en ese intervalo." Margin="0,10,0,0"
                               HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                </StackPanel>

                <ui:ProgressRing x:Name="anilloCarga" Grid.Row="1" IsIndeterminate="True"
                                 Width="48" Height="48" Visibility="Collapsed" />

                <TextBlock x:Name="txtTotal" Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource HintText}" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
