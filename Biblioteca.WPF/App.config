<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- La cadena vive en el proyecto de inicio (WPF). Ajusta el servidor si usas otra instalación
         (., localhost, .\SQLEXPRESS, (localdb)\MSSQLLocalDB). -->
    <add name="BibliotecaDB"
         connectionString="Server=.\SQLEXPRESS;Database=BibliotecaDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
